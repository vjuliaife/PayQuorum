DATA_AGENT_PRIVATE_KEY=0x_key
COMPUTE_AGENT_PRIVATE_KEY=0x_key
VALIDATOR_PRIVATE_KEY=0x_key
TREASURY_PRIVATE_KEY=0x_key

# --- Deployed contract addresses (from deploy script) ---
TASK_REGISTRY_ADDRESS=
AGENT_ESCROW_ADDRESS=
REPUTATION_ADDRESS=
BUDGET_CONTROLLER_ADDRESS=

# --- AIsa API (https://github.com/AIsa-team) ---
